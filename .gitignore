# ==================================================
# Development tools
# Keep the folder README, but do not upload binaries
# or third-party/cracked software.
# ==================================================
5--开发工具/*
!5--开发工具/README.md

# Compressed archives
*.zip
*.rar
*.7z
*.tar
*.gz

# Actual video files
# PPT and PPTX files are NOT ignored.
*.mp4
*.avi
*.wmv
*.mov
*.mkv
*.flv

# Executables and binary libraries
*.exe
*.EXE
*.dll
*.DLL
*.msi
*.iso

# CCS build output directories
Debug/
Release/
*/Debug/
*/Release/

# Compiler-generated files
*.obj
*.o
*.out
*.map
*.pdb
*.d
*.log
*.tmp
*.bak

# IDE-generated files
.vscode/
.idea/
.vs/
.metadata/

# Windows temporary files
Thumbs.db
Desktop.ini

# Local operation log
/进展.txt

# Office temporary files
~$*

# PDF.js viewer build artifacts — fetched & trimmed by scripts/build-viewer.mjs.
# Not committed: keeps history clean and makes upgrades a one-line version bump.
viewer/build/
viewer/web/
viewer/LICENSE
# Generated by scripts/scan-pdfs.mjs; rebuilt on every Pages deploy.
viewer/pdf-index.json
# Temp dir used by the viewer build script.
_pdfjs_build_tmp/
